# Segredos reais nunca sao versionados — ver docs/OBSERVABILITY-AND-CONFIG.md.
# O arquivo versionado e o .env.example, com placeholders.
.env
.env.*
!.env.example

# Mesma regra para o Secret do Kubernetes (feat-004) — k8s/secret.example.yaml e o
# versionado, com placeholders; k8s/secret.yaml (valores reais) nunca e versionado.
k8s/secret.yaml

# Cert/key TLS self-signed gerados por k8s/tls/generate-dev-cert.sh — material privado,
# regenerado sob demanda (script E' versionado, os artefatos gerados nao).
k8s/tls/*.crt
k8s/tls/*.key
