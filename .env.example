# Copie para .env e troque todos os valores antes de subir o ambiente.
# O .env real nunca e versionado (ver .gitignore e docs/OBSERVABILITY-AND-CONFIG.md).
#
#   cp .env.example .env
#
# Nenhuma variavel abaixo tem valor default no docker-compose.yml: sem .env, o
# `docker compose up` falha em vez de subir com credencial conhecida.

# --- PostgreSQL (um container por servico — Database per Service) ---
# Cada servico Java e dono exclusivo do seu banco. Dentro de cada banco ainda ha
# isolamento por schema por tenant (ver docs/DATA-MODEL.md).
POSTGRES_AUTH_DB=auth
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=troque-esta-senha-auth

POSTGRES_BETS_DB=bets
POSTGRES_BETS_USER=bets_user
POSTGRES_BETS_PASSWORD=troque-esta-senha-bets

POSTGRES_STATS_DB=stats
POSTGRES_STATS_USER=stats_user
POSTGRES_STATS_PASSWORD=troque-esta-senha-stats

# --- RabbitMQ ---
# Usado tanto pelo broker (usuario default) quanto pelo rabbitmq-init, que aplica
# rabbitmq/definitions.json pela API de gerenciamento depois do broker ficar healthy.
RABBITMQ_USER=stakevault
RABBITMQ_PASSWORD=troque-esta-senha-rabbitmq

# --- Redis (uso exclusivo de stats-service, padrao Cache-Aside) ---
REDIS_PASSWORD=troque-esta-senha-redis

# --- n8n (recebe o webhook do bot Telegram e aciona telegram-integration) ---
# Chave usada pelo n8n para cifrar credenciais no volume dele. Se mudar depois do
# primeiro boot, as credenciais ja salvas ficam ilegiveis.
N8N_ENCRYPTION_KEY=troque-esta-chave-n8n
